{
  "name": "agri-asaan-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agri/web",
    "build": "npm run build --workspace=@agri/web",
    "lint": "npm run lint --workspace=@agri/web",
    "typecheck": "npm run typecheck --workspace=@agri/web",
    "start": "npm run start --workspace=@agri/web",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:diff": "supabase db diff"
  },
  "packageManager": "npm@10.9.7",
  "devDependencies": {
    "supabase": "^3.2.0"
  }
}
