NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-local-or-hosted-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_DEMO_MODE=false
# Optional: MapLibre style URL. Defaults to OpenFreeMap (ADR 0016).
NEXT_PUBLIC_MAP_STYLE_URL=
REDIS_URL=redis://localhost:6379
VERCEL_TOKEN=your-vercel-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id

# Satellite worker (services/worker, ADR 0026). Server-side only: never
# prefix with NEXT_PUBLIC_. Local values come from `supabase status`; the
# local crop_worker password is the fake one in supabase/seed.sql.
WORKER_DATABASE_URL=postgresql://crop_worker:local-crop-worker-password@127.0.0.1:54322/postgres
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=local
STORAGE_S3_ACCESS_KEY_ID=your-storage-s3-access-key-id
STORAGE_S3_SECRET_ACCESS_KEY=your-storage-s3-secret-access-key
# Optional: STAC catalogue (default Earth Search), days of history for a new
# boundary (default 60), and fields per run (default 200).
STAC_API_URL=
BACKFILL_DAYS=
MAX_FIELDS_PER_RUN=
